models/*.gguf
# Built app (about 120 MB); source and commit in README.md
apks/*.apk
# Team test conversations and scribe instructions: not public (hashes in SHA256SUMS.txt)
prompts/
# Raw run output (phone logs and device snapshots)
results/
__pycache__/
# Excel lock files (a workbook open in Excel)
~$*
